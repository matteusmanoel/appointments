# Template único. Copie para `.env` na raiz e preencha os valores.
# docker compose lê este arquivo automaticamente para interpolação.

# --- App / API ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://navalhia:CHANGE_ME_POSTGRES@localhost:5433/navalhia
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES
JWT_SECRET=CHANGE_ME_JWT
JWT_EXPIRES_IN=7d
TOOLS_API_KEY=CHANGE_ME_TOOLS
APP_ENCRYPTION_KEY=CHANGE_ME_32_BYTES_OR_64_HEX
APP_URL=http://localhost:3002
CORS_ORIGIN=http://localhost:3002,http://localhost:8080,http://localhost:3000
VITE_API_URL=http://localhost:3003
VITE_NATIVE_AI_UI=true

# --- Seed local ---
SEED_BARBERSHOP_NAME=NavalhIA Teste Evolution
SEED_BARBERSHOP_SLUG=navalhia-teste
SEED_BARBERSHOP_PHONE=+5545988432998
SEED_BARBERSHOP_EMAIL=admin@navalhia.com.br
SEED_ADMIN_EMAIL=admin@navalhia.com.br
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=Admin Teste

# --- WhatsApp Evolution (instância de teste) ---
WHATSAPP_PROVIDER=evolution
EVOLUTION_API_URL=http://localhost:8081
EVOLUTION_API_KEY=CHANGE_ME_EVOLUTION_APIKEY
EVOLUTION_WEBHOOK_PUBLIC_URL=http://api:3000/api/webhooks/evolution
EVOLUTION_SERVER_URL=http://localhost:8081
EVOLUTION_POSTGRES_USER=evolution
EVOLUTION_POSTGRES_PASSWORD=CHANGE_ME_EVO_PG
EVOLUTION_POSTGRES_DB=evolution
EVOLUTION_REDIS_PASSWORD=CHANGE_ME_EVO_REDIS
CONFIG_SESSION_PHONE_CLIENT=Chrome
CONFIG_SESSION_PHONE_NAME=Chrome
TEST_WHATSAPP_INSTANCE_PHONE=5545988432998
TEST_WHATSAPP_CLIENT_PHONE=5545988230845
# A loja não tem allowlist de telefone. navalhia-lab é o chip pessoal de teste
# e não dispara o agente. Grupos são ignorados na Evolution e na Uazapi.
EVOLUTION_LAB_INSTANCE=navalhia-lab

# Janela de envio de lembretes/follow-ups (hora local da barbearia).
# Produção: 9–20. Teste local 24h: 0–24.
SCHEDULED_SEND_WINDOW_START=0
SCHEDULED_SEND_WINDOW_END=24

# --- Uazapi (cutover; vazio neste teste Evolution) ---
UAZAPI_BASE_URL=
UAZAPI_ADMIN_TOKEN=
UAZAPI_WEBHOOK_PUBLIC_URL=
UAZAPI_REQUIRE_WEBHOOK=false

# --- IA ---
OPENAI_API_KEY=
NATIVE_AI_DISABLED=false
AI_WORKER_CONCURRENCY=5
AI_JOB_MAX_ATTEMPTS=5
AI_JOB_BACKOFF_BASE_SECONDS=2
# Quiet window after the last WhatsApp bubble before the worker flushes the turn.
AI_INBOUND_QUIET_SECONDS=8

# --- Billing / e-mail (opcional neste teste) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PRICE_ID_ESSENTIAL=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_PREMIUM=
STRIPE_PRICE_ID_EXTRA_NUMBER=
STRIPE_PRICE_ID_FOLLOWUP_CREDIT=
FROM_EMAIL=
VITE_STRIPE_PUBLISHABLE_KEY=

# --- n8n / Meta Cloud (não usados neste teste) ---
N8N_CHAT_TRIGGER_URL=
N8N_CHAT_TIMEOUT_MS=120000
N8N_EVENTS_WEBHOOK_URL=
N8N_EVENTS_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Knowledge / AWS (opcional) ---
KNOWLEDGE_S3_BUCKET=
KNOWLEDGE_S3_PREFIX=knowledge
AWS_REGION=us-east-1
DATABASE_SSL=false
