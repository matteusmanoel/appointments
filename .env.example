# Template único. Copie para `.env` na raiz e preencha os valores.
# docker compose lê este arquivo automaticamente para interpolação.

# --- App / API ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://navalhia:CHANGE_ME_POSTGRES@localhost:5433/navalhia
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES
# --- Conexões (Neon / qualquer pooler de transação) ---
# DATABASE_URL         -> API (Lambda): use a URL COM pooler (host "-pooler" no Neon).
# DATABASE_URL_DIRECT  -> workers (advisory lock de sessão) e migrations: URL SEM pooler. Sem ela, usa DATABASE_URL.
# DATABASE_URL_DIRECT=postgres://USER:PASS@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
# Timeouts (ms) — padrões seguros; só mude se souber o motivo:
# DATABASE_CONNECTION_TIMEOUT_MS=10000
# DATABASE_IDLE_TIMEOUT_MS=30000
# DATABASE_QUERY_TIMEOUT_MS=30000
# DATABASE_DIRECT_STATEMENT_TIMEOUT_MS=120000
# DATABASE_POOL_MAX=5            # Lambda: poucas conexões por instância
# DATABASE_DIRECT_POOL_MAX=3
JWT_SECRET=CHANGE_ME_JWT
JWT_EXPIRES_IN=7d
TOOLS_API_KEY=CHANGE_ME_TOOLS
APP_ENCRYPTION_KEY=CHANGE_ME_32_BYTES_OR_64_HEX
APP_URL=http://localhost:3002
CORS_ORIGIN=http://localhost:3002,http://localhost:8080,http://localhost:3000
VITE_API_URL=http://localhost:3003
VITE_NATIVE_AI_UI=true

# Aceite do aviso de risco do WhatsApp no checkout: obrigatório no servidor (padrão). "false" desliga só durante a troca de versão
# entre front e API (ordem segura: publicar o front primeiro, depois a API).
CHECKOUT_REQUIRE_RISK_ACCEPTANCE=true

# --- Seed local ---
SEED_BARBERSHOP_NAME=NavalhIA Teste Evolution
SEED_BARBERSHOP_SLUG=navalhia-teste
SEED_BARBERSHOP_PHONE=+5545988432998
SEED_BARBERSHOP_EMAIL=admin@navalhia.com.br
SEED_ADMIN_EMAIL=admin@navalhia.com.br
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=Admin Teste

# --- WhatsApp Evolution (instância de teste) ---
WHATSAPP_PROVIDER=evolution            # padrão; alternativa: uazapi
WHATSAPP_INSTANCE_PREFIX=navalhia      # prefixo das instâncias (isola de outros apps no mesmo host Evolution)
EVOLUTION_API_URL=http://localhost:8081
EVOLUTION_API_KEY=CHANGE_ME_EVOLUTION_APIKEY
EVOLUTION_WEBHOOK_PUBLIC_URL=http://api:3000/api/webhooks/evolution
EVOLUTION_SERVER_URL=http://localhost:8081
EVOLUTION_POSTGRES_USER=evolution
EVOLUTION_POSTGRES_PASSWORD=CHANGE_ME_EVO_PG
EVOLUTION_POSTGRES_DB=evolution
EVOLUTION_REDIS_PASSWORD=CHANGE_ME_EVO_REDIS
CONFIG_SESSION_PHONE_CLIENT=Chrome
CONFIG_SESSION_PHONE_NAME=Chrome
TEST_WHATSAPP_INSTANCE_PHONE=5545988432998
TEST_WHATSAPP_CLIENT_PHONE=5545988230845
# A loja não tem allowlist de telefone. navalhia-lab é o chip pessoal de teste
# e não dispara o agente. Grupos são ignorados na Evolution e na Uazapi.
EVOLUTION_LAB_INSTANCE=navalhia-lab

# Janela de envio de lembretes/follow-ups (hora local da barbearia).
# Produção: 9–20. Teste local 24h: 0–24.
SCHEDULED_SEND_WINDOW_START=0
SCHEDULED_SEND_WINDOW_END=24

# --- Uazapi (cutover; vazio neste teste Evolution) ---
UAZAPI_BASE_URL=
UAZAPI_ADMIN_TOKEN=
UAZAPI_WEBHOOK_PUBLIC_URL=
UAZAPI_REQUIRE_WEBHOOK=false

# Segredo dos webhooks Uazapi/Evolution (Evolution: cabeçalho apikey; Uazapi: ?token= na URL). Dedicado: NÃO reutiliza EVOLUTION_API_KEY
# (o fallback para a chave mestra foi removido). OBRIGATÓRIO em produção: sem ele os webhooks respondem 503. Gere com: openssl rand -hex 32
WHATSAPP_WEBHOOK_SECRET=
# Segredo anterior, aceito só durante rotação (ver docs/RUNBOOK_WEBHOOK_SECRET.md). Deixe vazio fora de rotação.
WHATSAPP_WEBHOOK_SECRET_PREVIOUS=
# true só se a Evolution em uso ignorar `headers` no webhook: então o segredo vai também em ?token= (menos seguro).
EVOLUTION_WEBHOOK_TOKEN_IN_URL=
# App Secret do app Meta (valida X-Hub-Signature-256 no POST /api/webhooks/whatsapp). Sem ele o POST responde 503.
WHATSAPP_APP_SECRET=
# App Secret anterior da Meta, aceito só durante a troca no painel da Meta.
WHATSAPP_APP_SECRET_PREVIOUS=

# --- IA ---
OPENAI_API_KEY=
NATIVE_AI_DISABLED=false
AI_WORKER_CONCURRENCY=5
AI_JOB_MAX_ATTEMPTS=5
AI_JOB_BACKOFF_BASE_SECONDS=2

# --- Reaper de ai_jobs presos em processing (roda no ciclo do worker/Lambda de IA) ---
# AI_JOB_PROCESSING_TIMEOUT_SECONDS=240   # padrão = timeout da Lambda worker_ai (180 s) + 60 s; piso 195 s; também vale para o inbound
# AI_JOB_REAPER_INTERVAL_SECONDS=60       # no máximo 1 varredura por intervalo por processo
# (limite de tentativas/dead-letter reaproveita AI_JOB_MAX_ATTEMPTS e AI_JOB_BACKOFF_BASE_SECONDS)
# Quiet window after the last WhatsApp bubble before the worker flushes the turn.
AI_INBOUND_QUIET_SECONDS=8

# --- Billing / e-mail (opcional neste teste) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PRICE_ID_ESSENTIAL=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_PREMIUM=
STRIPE_PRICE_ID_EXTRA_NUMBER=
STRIPE_PRICE_ID_FOLLOWUP_CREDIT=

# Dias de tolerância após cobrança falhar antes de pausar IA e envios (padrão 7).
BILLING_GRACE_DAYS=7

# Aviso por e-mail ao dono quando a cobrança da assinatura falha (1 por fatura). DESLIGADO por padrão; só "true" liga.
BILLING_NOTIFY_PAYMENT_FAILED=false
FROM_EMAIL=
VITE_STRIPE_PUBLISHABLE_KEY=

# Aviso por e-mail ao dono quando as respostas de IA do mês chegam a X% do limite do plano (1 por mês). DESLIGADO por padrão.
AI_USAGE_ALERT_ENABLED=false
AI_USAGE_ALERT_THRESHOLD_PCT=80

# --- n8n / Meta Cloud (não usados neste teste) ---
N8N_CHAT_TRIGGER_URL=
N8N_CHAT_TIMEOUT_MS=120000
N8N_EVENTS_WEBHOOK_URL=
N8N_EVENTS_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Gatilho por evento do worker de IA (opcional; sem isto vale só o EventBridge de 1 min) ---
# URL da fila SQS (output ai_jobs_queue_url do Terraform). Injetada na API pelo Terraform.
# AI_JOBS_QUEUE_URL=

# --- Knowledge / AWS (opcional) ---
KNOWLEDGE_S3_BUCKET=
KNOWLEDGE_S3_PREFIX=knowledge
AWS_REGION=us-east-1
DATABASE_SSL=false

# Comando de teste «deletar» (apaga contexto do telefone). Só fora de produção e só para estes telefones (dígitos, separados por vírgula).
TEST_WIPE_PHONES=

# --- Rate limit dos endpoints públicos (agendar / reagendar / cancelar) ---
# Store: postgres (padrão, compartilhado entre instâncias; precisa da migration rate_limit_hits) | memory (por processo)
PUBLIC_RATE_LIMIT_STORE=postgres
# Desligar tudo (ex.: teste de carga): PUBLIC_RATE_LIMIT_ENABLED=false
# Limites (padrões): agendar 20/10min por IP e 5/h por telefone; cancelar/reagendar 30/10min por IP, 10/10min por token e 10/h por telefone; consulta por token 60/10min por IP
# PUBLIC_BOOKING_IP_MAX=20
# PUBLIC_BOOKING_IP_WINDOW_SEC=600
# PUBLIC_BOOKING_PHONE_MAX=5
# PUBLIC_BOOKING_PHONE_WINDOW_SEC=3600
# PUBLIC_MANAGE_IP_MAX=30
# PUBLIC_MANAGE_IP_WINDOW_SEC=600
# PUBLIC_MANAGE_TOKEN_MAX=10
# PUBLIC_MANAGE_TOKEN_WINDOW_SEC=600
# PUBLIC_MANAGE_PHONE_MAX=10
# PUBLIC_MANAGE_PHONE_WINDOW_SEC=3600
# PUBLIC_VIEW_IP_MAX=60
