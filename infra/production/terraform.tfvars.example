aws_region              = "us-east-2"
domain_name             = "navalhia.com"
app_subdomain           = "app"
api_subdomain           = "api"
attach_custom_domains   = false
budget_email            = "mateusmanoelfr@gmail.com"
budget_limit_usd        = "30"
from_email              = "no-reply@navalhia.com"
# Sem domínio próprio: identidade SES de e-mail (verificação individual). Sem default.
# Obrigatória com attach_custom_domains=false — o plan recusa vazio. Substitua pelo e-mail
# que você vai verificar no SES (link no inbox). Em sandbox, só destinatários verificados recebem.
ses_sender_email        = ""
# Front de produção: navalhia.com (domínio comprado na Vercel, ligado ao projeto `appointments`; www redireciona 308 para o apex).
# Vira APP_URL da API (success/return URLs do Stripe, links dos e-mails).
app_public_url          = "https://navalhia.com"
# Override opcional. Vazio = usa o api_endpoint do API Gateway no mesmo apply (sem ciclo).
api_public_url          = ""
# Apex novo + URL *.vercel.app mantida (preview/rollback). Depois do 1º apply, se usar CloudFront: ,https://<output cloudfront_domain>
cors_origin             = "https://navalhia.com,https://appointments-psi-five.vercel.app"
log_retention_days      = 14

# Copie para terraform.tfvars (gitignored) e preencha. Nunca commite valores reais.
# Plan com este example usa strings vazias — a API não funciona até o apply com secrets.
database_url            = ""
jwt_secret              = ""
app_encryption_key      = ""
whatsapp_provider      = "evolution"   # OBRIGATÓRIO com zip real, sem padrão: evolution | uazapi (produção usava uazapi antes deste tema)
evolution_api_url      = ""            # host externo sempre ligado; nada é provisionado aqui
evolution_api_key      = ""
whatsapp_instance_prefix = "navalhia"
uazapi_base_url         = ""
uazapi_admin_token      = ""
openai_api_key          = ""
stripe_secret_key       = ""
stripe_webhook_secret   = ""
stripe_price_id         = ""
stripe_price_id_essential = ""
stripe_price_id_pro     = ""

# Segredos dos webhooks de WhatsApp: NÃO coloque valores aqui. Use TF_VAR_whatsapp_webhook_secret,
# TF_VAR_whatsapp_app_secret e TF_VAR_whatsapp_verify_token (e, só durante rotação, TF_VAR_whatsapp_webhook_secret_previous).
stripe_price_id_premium = ""
stripe_price_id_extra_number = ""
stripe_price_id_followup_credit = ""
lambda_zip_path         = ""

# database_url_direct: NÃO coloque o valor aqui. Use TF_VAR_database_url_direct (URL sem pooler; vazio = reutiliza database_url).
